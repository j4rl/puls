Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,END]
    RewriteRule ^(?:includes|scripts|tests|deploy|var|node_modules)(?:/|$) - [F,END,NC]
</IfModule>
<FilesMatch "(?i)^(config(?:\.[^.]+)?\.php|database\.sql|README\.md|THIRD_PARTY_LICENSES\.txt|.*\.(?:sql|log|ini|env|bak))$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
